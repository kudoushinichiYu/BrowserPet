{
  "manifest_version": 3,
  "name": "BrowserPet 分组助手",
  "version": "0.2.0",
  "description": "只读同步 Chrome 原有标签组到本机 BrowserPet。无网页注入、无网络请求、无痕禁用。",
  "minimum_chrome_version": "105",
  "permissions": [
    "tabGroups",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BrowserPet：同步原有分组"
  },
  "key": ""
}
